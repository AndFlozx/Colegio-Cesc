---
interface Props { title: string; description: string; file: string; updated?: string; }
const { title, description, file, updated = 'Pendiente de actualización' } = Astro.props;
---

<article class="document-card">
  <div class="document-icon" aria-hidden="true">PDF</div>
  <div>
    <h2>{title}</h2>
    <p>{description}</p>
    <small>Última actualización: {updated}</small>
  </div>
  <a class="text-link" href={file} target="_blank" rel="noreferrer">Ver documento <span aria-hidden="true">→</span></a>
</article>
