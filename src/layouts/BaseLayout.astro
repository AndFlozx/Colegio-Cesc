---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Información institucional, admisiones y documentos oficiales del Colegio Centro Educativo SemiPresencial Cajibio.'
} = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1E3A2B" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <title>{title} | Colegio CESC</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido principal</a>
    <Header />
    <main id="contenido"><slot /></main>
    <Footer />
  </body>
</html>
